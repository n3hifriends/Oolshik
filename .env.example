# Mobile environment variables — copy to .env.local and fill in your values.
#
# For local dev the API URL is intentionally left empty: config.dev.ts falls
# back to Platform.select({ ios: localhost:8080, android: 10.0.2.2:8080 }).
#
# EAS build profiles inject these automatically:
#   development  → EXPO_PUBLIC_API_URL=""      (devHost fallback)
#   preview      → EXPO_PUBLIC_API_URL=https://api-dev.oolshik.in
#   production   → EXPO_PUBLIC_API_URL=https://www.oolshik.in

# Leave empty to use the per-platform devHost fallback (local dev only)
EXPO_PUBLIC_API_URL=

# Environment label used for logging / debug overlays
EXPO_PUBLIC_OOLSHIK_ENV=local

# Google OAuth client IDs (these are not secret — safe to commit or leave here)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=...
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=...
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=...
